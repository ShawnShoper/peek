    "未获得辅助功能权限，只能使用手动滚动模式" : {
      "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Accessibility permission is missing; only manual scrolling is available" } } }
    },
    "查看最近复制的文字、图片、链接和文件" : {
      "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "View recently copied text, images, links, and files" } } }
    },
    "框选屏幕区域并复制到剪贴板" : {
      "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Select a screen region and copy it to the clipboard" } } }
    },
    "框选屏幕文字并在本机识别" : {
      "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Select text on screen and recognize it locally" } } }
    },
